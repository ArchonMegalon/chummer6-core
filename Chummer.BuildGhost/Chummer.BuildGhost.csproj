    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chummer.BuildGhost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chummer.Contracts/Chummer.Contracts.csproj" />
