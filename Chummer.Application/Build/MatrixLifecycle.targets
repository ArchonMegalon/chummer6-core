  <Target Name="VerifyMatrixLifecycleNativeSources" BeforeTargets="CoreCompile">
    <GetFileHash Files="@(MatrixLifecycleNativeSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="HashedMatrixLifecycleNativeSource" />
    </GetFileHash>
    <Error Condition="'%(HashedMatrixLifecycleNativeSource.FileHash)' != '%(HashedMatrixLifecycleNativeSource.ExpectedSha256)'" Text="Native matrix initiative source drift: %(HashedMatrixLifecycleNativeSource.Identity). Re-review formula, AI, channel and active-persona semantics before updating pins." />
  </Target>
</Project>
