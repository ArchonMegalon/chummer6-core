    </GetFileHash>
    <Error Condition="'%(HashedNativeLoadoutSource1432.FileHash)' != '%(HashedNativeLoadoutSource1432.ExpectedSha256)'" Text="Native loadout1432 source drift: %(HashedNativeLoadoutSource1432.Identity). Re-review the exact native applicability branches before updating the pinned source version." />
