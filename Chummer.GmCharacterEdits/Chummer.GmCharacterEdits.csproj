<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">$(ChummerDesktopRuntimeIdentifiers)</RuntimeIdentifiers>
    <AssemblyName>Chummer.Engine.GmCharacterEdits</AssemblyName>
    <PackageId>Chummer.Engine.GmCharacterEdits</PackageId>
    <Version>0.0.0-local</Version>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Description>Store-backed Core application boundary for delegated GM character edits.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(ChummerLocalContractsProject)' != '' and Exists('$(ChummerLocalContractsProject)')">
    <ProjectReference Include="$(ChummerLocalContractsProject)">
      <PrivateAssets Condition="'$(ChummerRuntimePackagePlane)' != 'true'">all</PrivateAssets>
      <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(ChummerLocalContractsProject)' == '' or !Exists('$(ChummerLocalContractsProject)')">
    <PackageReference Include="Chummer.Engine.Contracts" Version="$(ChummerEngineContractsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Chummer.Application/Chummer.Application.csproj">
      <PrivateAssets Condition="'$(ChummerRuntimePackagePlane)' != 'true'">all</PrivateAssets>
      <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../Chummer.Infrastructure/Chummer.Infrastructure.csproj">
      <PrivateAssets Condition="'$(ChummerRuntimePackagePlane)' != 'true'">all</PrivateAssets>
      <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../Chummer.Rulesets.Hosting/Chummer.Rulesets.Hosting.csproj">
      <PrivateAssets Condition="'$(ChummerRuntimePackagePlane)' != 'true'">all</PrivateAssets>
      <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../Chummer.Rulesets.Sr5/Chummer.Rulesets.Sr5.csproj">
      <PrivateAssets Condition="'$(ChummerRuntimePackagePlane)' != 'true'">all</PrivateAssets>
      <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../Chummer.Rulesets.Sr6/Chummer.Rulesets.Sr6.csproj">
      <PrivateAssets Condition="'$(ChummerRuntimePackagePlane)' != 'true'">all</PrivateAssets>
      <AdditionalProperties>RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers)</AdditionalProperties>
    </ProjectReference>
    <PackageReference Include="Chummer.Hub.Registry.Contracts" Version="$(ChummerHubRegistryContractsPackageVersion)" />
    <PackageReference Include="Chummer.Run.Contracts" Version="$(ChummerRunContractsPackageVersion)" />
  </ItemGroup>

</Project>
