      <LegacyFlatOutputArtifacts Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\Chummer.Tests.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(LegacyFlatOutputArtifacts)" />
  </Target>
  <Target Name="RejectWorkspaceStoreTestHostFromTestOutput" AfterTargets="Build">
