<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunLegacyProbe Condition="'$(RunLegacyProbe)' == ''">false</RunLegacyProbe>
    <RunScopedStoreProbe Condition="'$(RunScopedStoreProbe)' == ''">false</RunScopedStoreProbe>
    <RunInventoryProbe Condition="'$(RunInventoryProbe)' == ''">false</RunInventoryProbe>
    <RunLocalAdoptionProbe Condition="'$(RunLocalAdoptionProbe)' == ''">false</RunLocalAdoptionProbe>
    <AssemblyName Condition="'$(RunLocalAdoptionProbe)' == 'true'">Chummer.CreationBootstrap.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.cs" />
    <Compile Include="MagicResonanceCases.cs" Condition="'$(RunLegacyProbe)' != 'true' and '$(RunScopedStoreProbe)' != 'true' and '$(RunInventoryProbe)' != 'true'" />
    <Compile Include="Program.cs" Condition="'$(RunLegacyProbe)' != 'true' and '$(RunScopedStoreProbe)' != 'true' and '$(RunInventoryProbe)' != 'true'" />
    <Compile Include="LegacyProbe.cs" Condition="'$(RunLegacyProbe)' == 'true' and '$(RunScopedStoreProbe)' != 'true' and '$(RunInventoryProbe)' != 'true'" />
    <Compile Include="ScopedStoreProbe.cs" Condition="'$(RunScopedStoreProbe)' == 'true' and '$(RunInventoryProbe)' != 'true'" />
    <Compile Include="InventoryProbe.cs" Condition="'$(RunInventoryProbe)' == 'true'" />
    <ProjectReference Include="../../Chummer.Application/Chummer.Application.csproj" />
    <ProjectReference Include="../../Chummer.Infrastructure/Chummer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunLocalAdoptionProbe)' == 'true'">
    <Compile Remove="Program.cs;MagicResonanceCases.cs;LegacyProbe.cs;ScopedStoreProbe.cs;InventoryProbe.cs" />
    <Compile Include="LocalAdoptionProbe.cs" />
  </ItemGroup>
</Project>
