<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunLegacyProbe Condition="'$(RunLegacyProbe)' == ''">false</RunLegacyProbe>
    <RunScopedStoreProbe Condition="'$(RunScopedStoreProbe)' == ''">false</RunScopedStoreProbe>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.cs" />
    <Compile Include="Program.cs" Condition="'$(RunLegacyProbe)' != 'true' and '$(RunScopedStoreProbe)' != 'true'" />
    <Compile Include="LegacyProbe.cs" Condition="'$(RunLegacyProbe)' == 'true' and '$(RunScopedStoreProbe)' != 'true'" />
    <Compile Include="ScopedStoreProbe.cs" Condition="'$(RunScopedStoreProbe)' == 'true'" />
    <ProjectReference Include="../../Chummer.Application/Chummer.Application.csproj" />
    <ProjectReference Include="../../Chummer.Infrastructure/Chummer.Infrastructure.csproj" />
  </ItemGroup>
</Project>
